# ============================================================
# PRAKASH TOUR & TRAVELS — ENVIRONMENT VARIABLES (Koyeb)
# ============================================================
# Copy to .env for local dev: cp .env.example .env
# On Koyeb: Service → Settings → Environment variables (mark
# secrets as "Secret" type, not plain text).
# ============================================================

# ---- Server ----
# Koyeb injects PORT itself — you normally don't need to set this.
PORT=3000
NODE_ENV=production

# ---- Database (required) ----
# Postgres connection string — Neon, Supabase, Koyeb's own managed
# Postgres add-on, or any reachable Postgres instance all work.
# After setting this, run: npx prisma migrate deploy
DATABASE_URL=

# ---- Admin authentication (required) ----
# Long random string used to sign admin session cookies (JWT).
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
# There is no default admin account. Create the first one by POSTing to
# /api/admin/init with an "Authorization: Bearer <ADMIN_SESSION_SECRET>"
# header and { "username": "...", "password": "..." } — see README.md.

# ---- File storage (required for receipt uploads) ----
# Any S3-compatible object storage works: AWS S3, Cloudflare R2,
# Backblaze B2, DigitalOcean Spaces, or a self-hosted MinIO instance.
# Koyeb has no built-in blob storage, so this must point somewhere real.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Leave blank for real AWS S3. Required for R2/B2/MinIO, e.g.:
#   Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2:   https://s3.<region>.backblazeb2.com
S3_ENDPOINT=
# Set to true only for providers that require path-style URLs (MinIO, some B2 setups)
S3_FORCE_PATH_STYLE=false
# Optional: if your bucket sits behind a CDN/custom domain, receipts will
# be linked via this base URL instead of the raw S3/R2/B2 endpoint.
S3_PUBLIC_URL_BASE=

# ---- Email — Resend (required to actually send emails) ----
RESEND_API_KEY=
EMAIL_FROM="Prakash Tour & Travels <onboarding@resend.dev>"
# For production, verify your own domain in Resend and use e.g.:
# EMAIL_FROM="Prakash Tour & Travels <booking@yourdomain.com>"

# ---- App URL (required — used to build links inside emails/payment pages) ----
# Local dev: http://localhost:3000   Production: your real Koyeb app URL
# (e.g. https://prakash-tour-travels-<org>.koyeb.app) or your custom domain
APP_URL=http://localhost:3000

# ---- Manual UPI payment details (used on the customer payment page) ----
UPI_ID=prakashtours@upi
UPI_DISPLAY_NAME=Prakash Tour & Travels

# ---- Payment gateway — OPTIONAL (Razorpay). Leave blank to run manual-UPI-only. ----
# When both keys are set, the payment page also offers an instant "Pay Online"
# button (api/payment/create-order.js, api/payment/verify-gateway.js).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Scheduled payment reminders ----
# The reminder job runs in-process via node-cron (see server.js) since
# Koyeb keeps this container alive continuously — no external cron
# service is required. Only needed if you'd rather trigger
# /api/cron/reminders externally instead (e.g. a separate Koyeb Cron Job
# service) or disable the in-process schedule.
DISABLE_CRON=false
REMINDER_CRON_SCHEDULE="0 9 * * *"
CRON_SECRET=

# ---- Business contact details shown in emails ----
BUSINESS_PHONE=8409150824
BUSINESS_WHATSAPP=918409150824
BUSINESS_EMAIL=info@prakashtourtravels.in
